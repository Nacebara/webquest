{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.entities->>'via_bot' AS via_bot, m.is_outgoing, m.text, m.received_at\n          FROM wallet_messages m JOIN operations op ON op.id = m.operation_id\n         WHERE op.order_id = $1\n         ORDER BY m.id DESC\n         LIMIT 12\n        ",
