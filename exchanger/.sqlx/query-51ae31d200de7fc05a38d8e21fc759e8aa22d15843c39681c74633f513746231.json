{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.alert_id, c.chat_id, c.message_id\n          FROM alert_copies c JOIN alerts a ON a.id = c.alert_id\n         WHERE a.resolved_at IS NOT NULL AND c.closed_at IS NULL AND c.message_id <> 0\n         ORDER BY c.alert_id\n         LIMIT $1\n        ",
