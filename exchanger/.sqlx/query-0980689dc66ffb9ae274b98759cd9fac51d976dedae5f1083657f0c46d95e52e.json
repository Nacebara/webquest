  "query": "\n        SELECT reason, banned_by, created_at, expires_at\n          FROM bans\n         WHERE user_id = $1 AND lifted_at IS NULL AND (expires_at IS NULL OR expires_at > now())\n         ORDER BY created_at DESC LIMIT 1\n        ",
