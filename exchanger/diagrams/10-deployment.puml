@startuml deployment
' Развёртывание: сервер владельца с Windows рядом с гарантом «Оплот» (docs/DEPLOY.md).
' Docker для exch не используется. Платёжных API и вебхуков нет — только Telegram.
' Сверено с DEPLOY.md и кодом 20.11.2026.
skinparam shadowing false
title Развёртывание (сервер владельца, Windows)

node "GitHub" as GH {
  artifact "репозиторий" as REPO
  artifact "Actions exchanger-ci:\nfmt, clippy, test,\nsqlx prepare --check" as CI
  artifact "артефакт exch-windows\n(exch.exe)" as BIN
}
node "Сервер владельца (Windows)" as SRV {
  component "гарант «Оплот»\n(не трогаем)" as OPLOT
  node "папка C:\\exch" as DIR {
    component "служба Windows exch\n(exch service install: после PostgreSQL,\nперезапуск при сбое 10 / 30 / 60 с)" as EXCH
    artifact ".env — только секреты:\nтокен бота, TG_API_HASH, SESSION_KEY,\nпароль базы (хранить отдельно от копий)" as ENV
    artifact "config.toml — остальное:\nчасовой пояс, поддержка,\n[backup] dir, [health] url" as CFG
    artifact "logs\\ — журнал" as LOGS
  }
  database "PostgreSQL 16\n(служба Windows; сессии юзерботов —\nтолько зашифрованные)" as PG
  artifact "копии базы: ежедневно 04:30,\nсразу проверка восстановлением,\n14 последних (exch backup)" as BKP
}
folder "папка копий [backup] dir\n(личная; облако — только личное,\nпока копии не шифруются, Б-19.1)" as COPIES
cloud "Telegram\nBot API (long polling, один бот)\nMTProto: юзерботы ↔ @send, @xrocket" as TG
cloud "healthchecks.io\n(сторож, по желанию)" as HC

REPO --> CI
CI --> BIN
BIN ..> EXCH : владелец кладёт exch.exe\n(обновление — RUNBOOK)
EXCH --> PG : localhost:5432
EXCH --> TG : HTTPS / MTProto\n(только исходящие)
EXCH --> HC : пинг раз в минуту,\nкогда движок жив
EXCH --> BKP
BKP --> COPIES
EXCH ..> ENV
EXCH ..> CFG
EXCH --> LOGS
@enduml
