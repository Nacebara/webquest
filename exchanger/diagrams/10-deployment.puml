@startuml deployment
' Развёртывание: DigitalOcean AMS3 (v0.2: только Telegram, платёжных API и вебхуков нет)
skinparam shadowing false
title Развёртывание (DigitalOcean AMS3)

node "Ноутбук разработчика (Windows)" as DEV {
  artifact "git, cargo,\nDocker Desktop" as DEVTOOLS
}
node "GitHub" as GH {
  artifact "репозиторий" as REPO
  artifact "Actions: fmt, clippy,\ntest, build image" as CI
  artifact "GHCR: образ exch:<sha>" as IMG
}
node "Droplet Ubuntu 24.04\n2 vCPU / 4 GB, AMS3" as VM {
  node "Docker Engine" as DOCKER {
    component "exch\n(контейнер, restart: unless-stopped)" as EXCH
    database "postgres:16\n(том pgdata; сессии юзерботов\nтолько зашифрованные)" as PG
  }
  artifact ".env (chmod 600)\nтокены ботов, TG_API_HASH,\nSESSION_KEY, CRYPTOBOT_PIN" as ENV
  artifact "systemd timer:\npg_dump → age → Spaces" as BKP
  artifact "ufw: только 22/tcp" as FW
}
cloud "DO Spaces / Backblaze B2\n(зашифрованные бэкапы)" as S3
cloud "Telegram\nBot API (long polling)\nMTProto: юзерботы ↔ @send, @xrocket" as TG
cloud "healthchecks.io\n(dead man's switch)" as HC

DEV --> REPO : git push
REPO --> CI
CI --> IMG
VM --> IMG : docker compose pull
EXCH --> PG : 5432 (внутр. сеть)
EXCH --> TG : HTTPS / MTProto (только исходящие)
EXCH --> HC : пинг раз в минуту
BKP --> S3 : ежесуточно
DEV --> VM : SSH (ключ ed25519)
@enduml
