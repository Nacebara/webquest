@startuml components
' Компоненты: один процесс exch (tokio), крейты рабочего пространства — карта из CLAUDE.md (v0.2).
' engine, tgbot, ops — ещё не созданы (вехи M3–M5).
skinparam shadowing false
skinparam componentStyle rectangle
title Компоненты (Cargo workspace, один бинарник exch)

package "exch (бинарник, tokio runtime)" {
  component "app\n(бинарник exch: конфиг,\nсупервизор, CLI)" as APP
  component "tgbot\n(клиентский бот) — M4" as TG
  component "ops\n(ops-бот: админка, алерты,\nстатистика) — M5" as OPS
  component "ui\n(экраны, клавиатуры,\nru.toml, rich + HTML)" as UI
  component "botapi\n(клиент Bot API 10.3)" as BA
  component "engine\n(FSM-драйвер, outbox,\nсверка, резервы) — M3" as ENG
  component "userbot\n(Transport, WalletBot,\nflows, sim)" as UB
  component "mtproto\n(grammers 0.10:\nGrammersTransport, сессия, вход)" as MT
  component "parsers\n(ссылки, суммы,\nответы ботов кошельков)" as PAR
  component "storage\n(sqlx, миграции,\nрепозитории)" as STO
  component "domain\n(деньги, цены, FSM,\nпроводки) — без IO" as DOM
}

cloud "Telegram Bot API\n(клиентский и ops-бот)" as TBA
cloud "Telegram MTProto\n(@send, @xrocket, «Избранное»)" as MTP
database "PostgreSQL 16" as PG

APP --> TG
APP --> OPS
APP --> ENG
APP --> MT
APP --> STO
TG --> UI
TG --> BA
TG --> ENG
OPS --> BA
OPS --> ENG
UI --> BA
UI --> DOM
ENG --> UB
ENG --> STO
ENG --> DOM
UB --> PAR
UB --> DOM
PAR --> DOM
MT ..|> UB : реализует Transport
MT --> DOM
STO --> DOM
STO --> PG
BA --> TBA
MT --> MTP
@enduml
