@startuml sequence-invoice-payment
' Последовательность: оплата счёта CryptoBot деньгами из xRocket (pay_cb_invoice, DESIGN-v0.2 Р4).
' Клиент платит чеком; счёт оплачивает юзербот через мини-приложение с PIN.
' Пока протокол мини-приложения не записан (HAR), исход — NeedsHuman и оператор.
skinparam shadowing false
autonumber "<b>[00]"
title Оплата счёта CryptoBot деньгами из xRocket

actor "Клиент" as C
participant "Клиентский бот" as BOT
participant "Ядро" as CORE
database "PostgreSQL" as DB
participant "Юзербот CryptoBot" as UBC
participant "@send (CryptoBot)" as SEND
participant "Мини-приложение\nCryptoBot (HTTP)" as WEB
participant "Юзербот xRocket" as UBX
participant "@xrocket" as XRB
actor "Оператор\n(ops-бот)" as OP

C -> BOT : t.me/send?start=IV…
BOT -> CORE : IncomingLink(invoice)
CORE -> DB : order NEW; operation(open_invoice)
CORE -> UBC : inspect_invoice(IV…)
UBC -> SEND : sendMessage("/start IV…", random_id)
SEND --> UBC : карточка счёта: 10 USDT, активен, кнопки
UBC -> DB : wallet_message(raw)
UBC -> CORE : InvoiceInfo{10 USDT, одноразовый, активен}
CORE -> DB : BEGIN; order→AWAITING_FUNDS (котировка: прислать 10.30,\nTTL 15 мин); hold(cb, 10.00); COMMIT
CORE -> BOT : котировка + [Пришлю чек xRocket] [Сумма] [Отмена]
BOT -> C : «Пришлите чек xRocket на 10.30 USDT — оплачу счёт на 10 USDT»

C -> BOT : t.me/xrocket?start=t_…
BOT -> CORE : ClientCheckSubmitted
CORE -> DB : order→INTAKE_PENDING; operation(activate_check)
CORE -> UBX : activate_check(t_…)
UBX -> XRB : sendMessage("/start t_…", random_id)
XRB --> UBX : «Вы получили 10.30 USDT»
UBX -> CORE : Received(10.30)
CORE -> DB : BEGIN; order→RECEIVED; ledger: Дт asset:xr / Кт payable;\nINSERT operation(pay_invoice, key=ord-77-pay, max_attempts=1);\norder→INVOICE_PAY_PENDING; COMMIT

CORE -> DB : operation→dispatched (коммит ДО нажатия)
CORE -> UBC : pay_invoice(IV…, USDT, 10.00)
UBC -> SEND : "/start IV…" — повторное открытие
SEND --> UBC : карточка, статус «активен»
UBC -> SEND : getBotCallbackAnswer(USDT),\nзатем getBotCallbackAnswer(«Оплатить»)
SEND --> UBC : кнопка мини-приложения
UBC -> SEND : messages.requestWebView → URL с tgWebAppData
alt протокол мини-приложения записан (после HAR, M6)
  UBC -> WEB : ввод PIN (CRYPTOBOT_PIN), подтверждение
  WEB --> UBC : оплачено
  SEND --> UBC : «Счёт оплачен»
  UBC -> CORE : PayOutcome::Paid
  CORE -> DB : order→COMPLETED; ledger: Дт payable 10.30 /\nКт asset:cb 10.00 / Кт revenue:fee 0.30; hold → consumed
  CORE -> BOT : «Счёт оплачен»
else сейчас: протокол неизвестен
  UBC -> CORE : PayOutcome::NeedsHuman
  CORE -> DB : order→MANUAL_REVIEW (InvoicePayNeedsHuman)
  CORE -> BOT : «Заявка на ручной проверке, деньги у меня» (S8)
  CORE -> OP : задача «оплати счёт вручную» (SLA 15 мин)
  OP -> SEND : оплата со служебного аккаунта\n(Telegram Desktop, юзербот на паузе)
  OP -> CORE : «Оплачено» (Operator(CloseAsPaid))\nили «Не получилось» (Operator(Refund))
else таймаут / незнакомый ответ после «Оплатить»
  UBC -> CORE : PayOutcome::Unknown
  CORE -> DB : order→MANUAL_REVIEW; повторно НЕ нажимаем
  CORE -> UBC : inspect_invoice + balances — сверка для оператора
end
@enduml
