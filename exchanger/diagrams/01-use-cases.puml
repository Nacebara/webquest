@startuml use-cases
' Варианты использования бота-обменника xRocket <-> CryptoBot (v0.2: всё через юзербота)
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false

actor "Клиент" as Client
actor "Владелец" as Owner
actor "Админ" as Admin
actor "Оператор" as Operator
actor "Юзербот\n(выделенный аккаунт Telegram,\nпо одному на платформу)" as Userbot <<system>>
actor "CryptoBot\n(@send)" as CB <<external>>
actor "xRocket\n(@xrocket)" as XR <<external>>

Owner --|> Admin
Admin --|> Operator

rectangle "Бот-обменник" {
  usecase "Узнать курс и лимиты" as UC_Terms
  usecase "Обменять чек\nCryptoBot → xRocket\n(основной поток)" as UC_CX
  usecase "Обменять чек\nxRocket → CryptoBot" as UC_XC
  usecase "Оплатить счёт CryptoBot\nденьгами из xRocket" as UC_PayCB
  usecase "Оплатить счёт xRocket\nденьгами из CryptoBot" as UC_PayXR
  usecase "Забрать чек выплаты\nили возврата" as UC_Claim
  usecase "История и статус заявки" as UC_History
  usecase "Помощь / поддержка" as UC_Help

  usecase "Активировать чек\n(/start <код>)" as UC_Activate
  usecase "Создать чек выплаты\nили возврата\n(инлайн → «Избранное», меню)" as UC_Issue
  usecase "Открыть и оплатить\nчужой счёт" as UC_PayInvoice
  usecase "Прочитать баланс,\nсверить с леджером" as UC_Reconcile

  usecase "Разобрать заявку вручную" as UC_Manual
  usecase "Оплатить счёт CryptoBot\nвручную (PIN, пока нет HAR)" as UC_ManualPay
  usecase "Карточка пользователя,\nпоиск заявки" as UC_Search
  usecase "Бан / разбан" as UC_Ban
  usecase "Маржа, лимиты,\nпауза направления" as UC_Pricing
  usecase "Ребалансировка резервов,\nвывод прибыли" as UC_Rebalance
  usecase "Статистика и дашборды" as UC_Stats
  usecase "Рассылка, экспорт CSV" as UC_Broadcast
  usecase "Роли, режим обслуживания,\nсессии юзерботов" as UC_Owner
  usecase "Логи и алерты по темам" as UC_Logs
}

Client --> UC_Terms
Client --> UC_CX
Client --> UC_XC
Client --> UC_PayCB
Client --> UC_PayXR
Client --> UC_Claim
Client --> UC_History
Client --> UC_Help
UC_CX ..> UC_Activate : <<include>>
UC_XC ..> UC_Activate : <<include>>
UC_CX ..> UC_Issue : <<include>>
UC_XC ..> UC_Issue : <<include>>
UC_PayCB ..> UC_Activate : <<include>>\n(клиент платит чеком)
UC_PayXR ..> UC_Activate : <<include>>
UC_PayCB ..> UC_PayInvoice : <<include>>
UC_PayXR ..> UC_PayInvoice : <<include>>
UC_ManualPay ..> UC_PayInvoice : <<extend>>
UC_Claim ..> UC_Issue : <<include>>

Userbot --> UC_Activate
Userbot --> UC_Issue
Userbot --> UC_PayInvoice
Userbot --> UC_Reconcile
UC_Activate --> CB
UC_Activate --> XR
UC_Issue --> CB
UC_Issue --> XR
UC_PayInvoice --> CB
UC_PayInvoice --> XR
UC_Reconcile --> CB
UC_Reconcile --> XR

Operator --> UC_Manual
Operator --> UC_ManualPay
Operator --> UC_Search
Operator --> UC_Logs
Admin --> UC_Ban
Admin --> UC_Pricing
Admin --> UC_Stats
Admin --> UC_Broadcast
Admin --> UC_Reconcile
Owner --> UC_Rebalance
Owner --> UC_Owner
@enduml
