@startuml sequence-check-exchange
' Последовательность: обмен чека CryptoBot -> xRocket (основной поток, DESIGN-v0.2).
' Приём и выплата — юзерботы; выплата — create_payout_check (одна попытка, random_id).
skinparam shadowing false
autonumber "<b>[00]"
title Обмен чека CryptoBot → xRocket

actor "Клиент" as C
participant "Клиентский бот\n(tgbot + botapi)" as BOT
participant "Ядро\n(engine: FSM + outbox)" as CORE
database "PostgreSQL" as DB
participant "Юзербот CryptoBot\n(актор, mtproto)" as UBC
participant "@send" as SEND
participant "Юзербот xRocket\n(актор, mtproto)" as UBX
participant "@xrocket" as XRB
participant "Ops-бот" as OPS

C -> BOT : ссылка t.me/send?start=CQ…
BOT -> CORE : IncomingLink{user, CryptoBot, CQ…}
CORE -> DB : SELECT direction, reserves, bans, limits
CORE -> DB : BEGIN; INSERT order(NEW→INTAKE_PENDING);\nINSERT operation(activate_check, key=ord-42-intake-1, random_id);\nINSERT hold(xr, max_order_eff); COMMIT
CORE -> BOT : сообщение заявки
BOT -> C : «Проверяю чек…»

CORE -> DB : UPDATE operation SET status='dispatched'; COMMIT
note right of CORE : коммит ДО отправки команды
CORE -> UBC : activate_check(CQ…, OpTag{key, random_id})
UBC -> SEND : messages.sendMessage("/start CQ…",\nno_webpage, random_id)
SEND --> UBC : «Вы получили 100 USDT»\n(возможно, правкой после «обработка»)
UBC -> DB : INSERT wallet_message(raw) — всегда, до разбора
UBC -> CORE : ActivationOutcome::Received(100 USDT)
CORE -> DB : BEGIN; operation→succeeded; order→RECEIVED;\nledger: Дт asset:cb 100 / Кт payable 100;\nhold := 97.50; INSERT operation(create_payout_check,\nkey=ord-42-payout, random_id, max_attempts=1);\norder→PAYOUT_PENDING; COMMIT
CORE -> BOT : edit «Чек принят: 100 USDT. Готовлю чек xRocket на 97.50…»

CORE -> DB : UPDATE operation SET status='dispatched'; COMMIT
CORE -> UBX : issue_check(97.50 USDT, OpTag{key, random_id})
UBX -> XRB : messages.getInlineBotResults("97.5")
XRB --> UBX : результаты (USDT 97.5 …)
UBX -> XRB : messages.sendInlineBotResult(→ «Избранное», random_id)
XRB --> UBX : сообщение-чек в «Избранном» с URL-кнопкой\n(кнопка может прийти правкой)
UBX -> DB : INSERT wallet_message(raw)
alt ссылка получена
  UBX -> CORE : IssueOutcome::Issued{t.me/xrocket?start=t_…, Inline}
else ошибка ДО sendInlineBotResult
  UBX -> XRB : меню: /cheques → «Персональный» →\n«Создать чек» → USDT → 97.5
  XRB --> UBX : чек со ссылкой
  UBX -> CORE : IssueOutcome::Issued{…, Menu}
else сбой или таймаут ПОСЛЕ отправки
  UBX -> CORE : IssueOutcome::Unknown
  CORE -> UBX : find_issued_check(97.50, OpTag)\n— повторно чек НЕ создаём
  UBX --> CORE : чек найден / не найден
  note right of CORE : не найден или неясно →\nPayoutFailed → MANUAL_REVIEW
end
CORE -> DB : BEGIN; operation→succeeded(external_id = ссылка);\norder→COMPLETED; ledger: Дт payable 100 /\nКт asset:xr 97.50 / Кт revenue:fee 2.50;\nhold → consumed; payout_check_url; COMMIT
CORE -> BOT : edit итог
BOT -> C : «Ваш чек xRocket на 97.50 USDT»\n[Забрать чек] [Скопировать ссылку]
CORE -> OPS : лог в тему «Обмены» (агрегировано)
@enduml
