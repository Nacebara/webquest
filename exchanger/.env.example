# .env — только секреты exch. Обычно его пишет мастер: exch setup (или первый запуск exch.exe).
# Файл не коммитится и никому не пересылается: не в чаты, не в промты, не в логи.
# Остальные настройки (часовой пояс, поддержка, логи, пульс) — в config.toml.
# Переменные окружения с теми же именами сильнее обоих файлов (так работает сервер).

# База PostgreSQL: пароль пользователя postgres, база exch создаётся сама.
DATABASE_URL=postgres://postgres:<password>@localhost:5432/exch
# Ваш Telegram ID (мастер узнаёт его сам по сообщению боту).
OWNER_TG_ID=
# Бот (@BotFather): в нём и клиенты, и ваша админ-панель.
CLIENT_BOT_TOKEN=
# Юзербот: my.telegram.org → API development tools.
TG_API_ID=
TG_API_HASH=
# Ключ шифрования сессий юзерботов (мастер создаёт сам; потеряете — войти заново).
SESSION_KEY=
# Необязательная сверка закреплённых ботов кошельков (по умолчанию 1559501630 и 5014831088).
CRYPTOBOT_PEER_ID=
XROCKET_PEER_ID=
