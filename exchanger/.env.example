# Скопируйте в .env и заполните. .env не коммитится. Значения секретов — только здесь
# или в окружении сервера: не в промтах, не в логах, не в коммитах.
# Обязательные с вехи M1:
DATABASE_URL=postgres://exch:<password>@localhost:5432/exch
OWNER_TG_ID=
# M2 — юзербот (my.telegram.org → API development tools; ключ: openssl rand -base64 32):
TG_API_ID=
TG_API_HASH=
SESSION_KEY=
# PIN CryptoBot для оплаты счетов в мини-приложении (DESIGN-v0.2, Р4):
CRYPTOBOT_PIN=
# Необязательная сверка закреплённых ботов (по умолчанию 1559501630 и 5014831088):
CRYPTOBOT_PEER_ID=
XROCKET_PEER_ID=
# M4 — клиентский бот, M5 — ops-бот и пульс:
CLIENT_BOT_TOKEN=
OPS_BOT_TOKEN=
HEALTHCHECK_URL=
TZ_OWNER=Europe/Moscow
RUST_LOG=info
